# Copy to .env. Every value below is the default.

# Port the API listens on.
PORT=8080

# Host in the payment link of each invoice.
BILLING_HOST=billing.brightwave.internal

# Address printed on each invoice.
SUPPORT_EMAIL=support@brightwave-supply.com

# Orders one customer may create per window. Over the limit, POST /orders answers 429.
ORDER_RATE_LIMIT=60

# Length of the rate limit window, in seconds.
ORDER_RATE_WINDOW_SECONDS=60
